<ui:FluentWindow x:Class="RootDock.App.Dialogs.CustomCommandWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Meu comando"
                 Width="520"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 ShowInTaskbar="False"
                 Background="{DynamicResource RdSurface}">
    <StackPanel>
        <ui:TitleBar x:Name="TitleBar" Title="Novo comando" ShowMaximize="False" ShowMinimize="False" />
        <StackPanel Margin="24,4,24,20">
            <TextBlock Text="Nome" Margin="0,0,0,4" />
            <ui:TextBox x:Name="TitleBox" PlaceholderText="ex.: Reiniciar fila do sistema" Margin="0,0,0,12" />

            <TextBlock Text="Comando" Margin="0,0,0,4" />
            <ui:TextBox x:Name="CommandBox" FontFamily="Cascadia Mono, Consolas" PlaceholderText="ex.: tail -n {{linhas}} /var/log/app.log"
                        AcceptsReturn="True" MinHeight="38" MaxHeight="180" VerticalScrollBarVisibility="Auto" TextChanged="OnCommandChanged" />
            <TextBlock Margin="0,4,0,12" FontSize="11.5" Foreground="{DynamicResource RdTextDim}" TextWrapping="Wrap"
                       Text="Use {{nome}} para campos que você preenche na hora de executar (os valores são escapados para o shell). Várias linhas viram uma macro: cada linha é executada em sequência." />

            <TextBlock Text="O que faz (opcional)" Margin="0,0,0,4" />
            <ui:TextBox x:Name="DescriptionBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54" Margin="0,0,0,10" />

            <CheckBox x:Name="CautionCheck" Content="Pedir confirmação antes de executar (altera algo no servidor)" />
            <TextBlock x:Name="DangerText" Margin="0,8,0,0" Foreground="{DynamicResource RdProd}" TextWrapping="Wrap" Visibility="Collapsed"
                       Text="Este comando parece destrutivo (apaga, reinicia ou reescreve algo). Ele sempre vai pedir confirmação." />
            <TextBlock x:Name="ErrorText" Margin="0,8,0,0" Foreground="{DynamicResource RdProd}" TextWrapping="Wrap" Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <ui:Button Content="Cancelar" IsCancel="True" Margin="0,0,8,0" MinWidth="96" Click="OnCancel" />
                <ui:Button Content="Salvar" IsDefault="True" Appearance="Primary" MinWidth="96" Click="OnSave" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
