<ui:FluentWindow x:Class="RootDock.App.Dialogs.NetworkToolsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Ferramentas de rede"
                 Width="1140" Height="760" MinWidth="880" MinHeight="520"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 ShowInTaskbar="True"
                 Background="{DynamicResource RdSurface}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Title="Ferramentas de rede" />

        <Grid Grid.Row="1" Margin="12,4,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox x:Name="ToolsList" SelectionChanged="OnToolChanged" BorderThickness="0" Background="Transparent">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,7" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="18" Margin="0,0,10,0" Foreground="{DynamicResource RdAccent}" />
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Short}" FontSize="11" Foreground="{DynamicResource RdTextDim}" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Column="2" Background="{DynamicResource RdPanel}" BorderBrush="{DynamicResource RdBorder}" BorderThickness="1" CornerRadius="8" Padding="16,14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock x:Name="ToolTitle" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock x:Name="ToolDescription" Foreground="{DynamicResource RdTextDim}" TextWrapping="Wrap" Margin="0,2,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="InputBox" FontFamily="Cascadia Mono, Consolas" PreviewKeyDown="OnInputKey" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                <ui:Button x:Name="ActiveHostButton" Content="Do terminal" Margin="0,0,8,0" Click="OnUseActiveHost"
                                           ToolTip="Usa o servidor do terminal ativo" Icon="{ui:SymbolIcon WindowConsole20}" />
                                <ui:Button x:Name="RunButton" Content="Executar" Appearance="Primary" MinWidth="110" Click="OnRun" Icon="{ui:SymbolIcon Play20}" />
                                <ui:Button x:Name="StopButton" Content="Parar" MinWidth="110" Click="OnStop" Visibility="Collapsed" Icon="{ui:SymbolIcon Stop20}" />
                            </StackPanel>
                        </Grid>
                        <WrapPanel x:Name="OptionsPanel" Margin="0,10,0,0" />
                        <TextBlock x:Name="NoteText" Foreground="{DynamicResource RdStaging}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />
                    </StackPanel>

                    <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <ui:Button DockPanel.Dock="Right" Content="Copiar resultado" Click="OnCopy" Icon="{ui:SymbolIcon Copy20}" />
                        <ui:ProgressRing x:Name="Busy" DockPanel.Dock="Left" IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0" Visibility="Collapsed" />
                        <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{DynamicResource RdTextDim}" TextTrimming="CharacterEllipsis" />
                    </DockPanel>

                    <TextBox x:Name="OutputBox" Margin="0,12,0,0" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="12.5"
                             Background="{DynamicResource RdInset}" BorderBrush="{DynamicResource RdBorder}" Padding="10,8"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
