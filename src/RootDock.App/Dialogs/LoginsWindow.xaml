<ui:FluentWindow x:Class="RootDock.App.Dialogs.LoginsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Logins salvos"
                 Width="600"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 ShowInTaskbar="False"
                 Background="{DynamicResource RdSurface}">
    <StackPanel>
        <ui:TitleBar Title="Logins salvos" ShowMaximize="False" ShowMinimize="False" />
        <StackPanel Margin="24,6,24,20">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Person20" FontSize="22" Foreground="{DynamicResource RdAccent}" VerticalAlignment="Center" />
                <TextBlock x:Name="HeaderText" Margin="10,0,0,0" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <TextBlock x:Name="EndpointText" Margin="32,2,0,0" Foreground="{DynamicResource RdTextDim}" />
            <TextBlock Margin="0,12,0,10" Foreground="{DynamicResource RdTextDim}" TextWrapping="Wrap"
                       Text="Usuários que o RootDock pode usar para entrar neste servidor. As senhas ficam no Cofre do Windows, nunca em arquivo." />

            <!-- Lista -->
            <Border CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource RdBorder}" Background="{DynamicResource RdBackground}">
                <StackPanel>
                    <StackPanel x:Name="Rows" />
                    <TextBlock x:Name="EmptyText" Margin="14,14" Foreground="{DynamicResource RdTextDim}" TextWrapping="Wrap"
                               Text="Nenhum login salvo. Adicione abaixo, ou entre pelo terminal e escolha &quot;Usuário e senha&quot; no aviso que aparece." />
                </StackPanel>
            </Border>

            <!-- Adicionar / trocar senha -->
            <TextBlock x:Name="FormTitle" Text="Adicionar login" Margin="0,18,0,6" FontWeight="SemiBold" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox x:Name="UserBox" PlaceholderText="Usuário (ex.: root)" />
                <ui:PasswordBox x:Name="PasswordBox" Grid.Column="2" PlaceholderText="Senha (vazia = pedir ao conectar)" />
                <ui:Button x:Name="SaveButton" Grid.Column="4" Content="Salvar login" Appearance="Primary" Click="OnSaveLogin" />
            </Grid>
            <TextBlock x:Name="FormError" Margin="0,6,0,0" Foreground="{DynamicResource RdProd}" Visibility="Collapsed" />

            <CheckBox x:Name="ChooseBox" Margin="0,16,0,0" Click="OnChooseChanged"
                      Content="Com mais de um login salvo, perguntar qual usar ao abrir a sessão (Enter escolhe o padrão)" />

            <!-- Chave SSH -->
            <Border Margin="0,14,0,0" Padding="12,10" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource RdBorder}">
                <DockPanel>
                    <ui:Button x:Name="RemoveKeyButton" DockPanel.Dock="Right" Content="Não usar a chave" Margin="10,0,0,0" Click="OnRemoveKey" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Key20" Foreground="{DynamicResource RdTextDim}" VerticalAlignment="Center" />
                        <TextBlock x:Name="KeyText" Margin="8,0,0,0" TextWrapping="Wrap" MaxWidth="420" Foreground="{DynamicResource RdTextDim}" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <ui:Button Content="Fechar" IsCancel="True" MinWidth="96" Click="OnClose" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
