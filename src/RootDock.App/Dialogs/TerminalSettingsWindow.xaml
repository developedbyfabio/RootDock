<ui:FluentWindow x:Class="RootDock.App.Dialogs.TerminalSettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Aparência do terminal"
                 Width="920"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 ShowInTaskbar="False"
                 Background="{DynamicResource RdSurface}">
    <ui:FluentWindow.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
    </ui:FluentWindow.Resources>
    <StackPanel>
        <ui:TitleBar Title="Aparência do terminal" ShowMaximize="False" ShowMinimize="False" />
        <Grid Margin="24,8,24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Cores" FontWeight="SemiBold" Margin="0,0,0,6" />
                <ListBox x:Name="ThemesList" SelectionChanged="OnChanged" BorderThickness="0" Background="Transparent" Margin="0,0,0,12">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="6,4" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Swatches}" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="12" Height="12" CornerRadius="3" Margin="3,0,0,0" Background="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border Width="34" Height="22" CornerRadius="4" Background="{Binding Background}" BorderBrush="#33FFFFFF" BorderThickness="1" Margin="0,0,10,0">
                                    <TextBlock Text="Aa" Foreground="{Binding Foreground}" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Fonte" Style="{StaticResource Label}" />
                    <ComboBox Grid.Column="1" x:Name="FontBox" SelectionChanged="OnChanged" />

                    <TextBlock Grid.Row="1" Text="Tamanho" Style="{StaticResource Label}" Margin="0,10,12,0" />
                    <ui:NumberBox Grid.Row="1" Grid.Column="1" x:Name="SizeBox" Minimum="8" Maximum="32" SpinButtonPlacementMode="Inline"
                                  Width="140" HorizontalAlignment="Left" Margin="0,10,0,0" />

                    <TextBlock Grid.Row="2" Text="Espaço entre linhas" Style="{StaticResource Label}" Margin="0,10,12,0" />
                    <ComboBox Grid.Row="2" Grid.Column="1" x:Name="LineHeightBox" SelectionChanged="OnChanged" Margin="0,10,0,0">
                        <ComboBoxItem Content="Compacto (1,0)" Tag="1.0" />
                        <ComboBoxItem Content="Normal (1,1)" Tag="1.1" />
                        <ComboBoxItem Content="Confortável (1,25)" Tag="1.25" />
                        <ComboBoxItem Content="Amplo (1,4)" Tag="1.4" />
                    </ComboBox>

                    <TextBlock Grid.Row="3" Text="Cursor" Style="{StaticResource Label}" Margin="0,10,12,0" />
                    <WrapPanel Grid.Row="3" Grid.Column="1" Margin="0,10,0,0">
                        <RadioButton x:Name="CursorBar" Content="Barra" GroupName="Cursor" Margin="0,0,14,0" Checked="OnChanged" MinWidth="0" />
                        <RadioButton x:Name="CursorBlock" Content="Bloco" GroupName="Cursor" Margin="0,0,14,0" Checked="OnChanged" MinWidth="0" />
                        <RadioButton x:Name="CursorUnderline" Content="Sublinhado" GroupName="Cursor" Margin="0,0,18,0" Checked="OnChanged" MinWidth="0" />
                        <CheckBox x:Name="BlinkBox" Content="Piscar" Checked="OnChanged" Unchecked="OnChanged" MinWidth="0" />
                    </WrapPanel>

                    <TextBlock Grid.Row="4" Text="Histórico de rolagem" Style="{StaticResource Label}" Margin="0,10,12,0" />
                    <ComboBox Grid.Row="4" Grid.Column="1" x:Name="ScrollbackBox" Margin="0,10,0,0">
                        <ComboBoxItem Content="5.000 linhas" Tag="5000" />
                        <ComboBoxItem Content="20.000 linhas (recomendado)" Tag="20000" />
                        <ComboBoxItem Content="50.000 linhas" Tag="50000" />
                        <ComboBoxItem Content="100.000 linhas (usa mais memória)" Tag="100000" />
                    </ComboBox>
                </Grid>

                <TextBlock Text="Comportamento" FontWeight="SemiBold" Margin="0,4,0,6" />
                <CheckBox x:Name="HighlightBox" Content="Destacar ERROR, WARNING, FAILED e OK na saída" Checked="OnChanged" Unchecked="OnChanged" Margin="0,0,0,4" />
                <CheckBox x:Name="CopyOnSelectBox" Content="Copiar automaticamente ao selecionar texto" Margin="0,0,0,4" />
                <CheckBox x:Name="RightClickBox" Content="Botão direito cola (desligado: abre um menu)" ToolTip="Desligado, o botão direito abre um menu com copiar, colar, buscar e salvar o terminal" />
            </StackPanel>

            <!-- Prévia -->
            <StackPanel Grid.Column="2">
                <TextBlock Text="Prévia" FontWeight="SemiBold" Margin="0,0,0,6" />
                <Border x:Name="PreviewBox" CornerRadius="8" Padding="12,10" BorderBrush="{DynamicResource RdBorder}" BorderThickness="1">
                    <TextBlock x:Name="PreviewText" TextWrapping="NoWrap" />
                </Border>
                <TextBlock Text="As mudanças valem para todos os terminais, inclusive os já abertos." Margin="0,10,0,0"
                           Foreground="{DynamicResource RdTextDim}" FontSize="11.5" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <DockPanel Margin="24,0,24,20">
            <ui:Button Content="Restaurar padrão" Click="OnDefaults" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Cancelar" IsCancel="True" Margin="0,0,8,0" MinWidth="96" />
                <ui:Button Content="Salvar" IsDefault="True" Appearance="Primary" MinWidth="110" Click="OnSave" />
            </StackPanel>
        </DockPanel>
    </StackPanel>
</ui:FluentWindow>
