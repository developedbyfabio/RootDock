<ui:FluentWindow x:Class="RootDock.App.Dialogs.AboutWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Sobre o RootDock"
                 Width="620" SizeToContent="Height" ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 ShowInTaskbar="False"
                 Background="{DynamicResource RdSurface}">
    <StackPanel>
        <ui:TitleBar Title="Sobre o RootDock" ShowMinimize="False" ShowMaximize="False" />
        <StackPanel Margin="24,4,24,20">
            <DockPanel>
                <Image Source="pack://application:,,,/Assets/rootdock-64.png" Width="56" Height="56" Margin="0,0,16,0" VerticalAlignment="Top" />
                <StackPanel>
                    <TextBlock Text="RootDock" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock x:Name="VersionText" Foreground="{DynamicResource RdTextDim}" Margin="0,2,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <ui:SymbolIcon Symbol="Person20" FontSize="15" Foreground="{DynamicResource RdAccent}" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource RdText}">
                            <Run Text="Criado por" Foreground="{DynamicResource RdTextDim}" />
                            <Run x:Name="AuthorText" FontWeight="SemiBold" />
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Text="Terminais SSH, Telnet e Serial, Área de Trabalho Remota, VNC, SFTP, FTP e arquivos de servidores Windows numa janela só."
                               TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource RdText}" />
                </StackPanel>
            </DockPanel>

            <Border Margin="0,18,0,0" Padding="14,10" Background="{DynamicResource RdPanel}" BorderBrush="{DynamicResource RdBorder}" BorderThickness="1" CornerRadius="8">
                <Grid x:Name="InfoGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                </Grid>
            </Border>

            <TextBlock Text="Componentes de código aberto" FontWeight="SemiBold" Margin="0,16,0,6" />
            <TextBlock x:Name="ComponentsText" Foreground="{DynamicResource RdTextDim}" TextWrapping="Wrap" FontSize="12.5" LineHeight="20" />

            <TextBlock x:Name="CopyrightText" Margin="0,14,0,0" FontSize="12" Foreground="{DynamicResource RdTextDim}" />

            <DockPanel Margin="0,20,0,0" LastChildFill="False">
                <ui:Button Content="Copiar informações" Icon="{ui:SymbolIcon Copy20}" Click="OnCopy"
                           ToolTip="Copia versão, sistema e pastas (útil para relatar um problema)" />
                <ui:Button x:Name="UpdatesButton" Content="Verificar atualizações" Icon="{ui:SymbolIcon ArrowSync20}" Click="OnUpdates" Margin="8,0,0,0" />
                <ui:Button DockPanel.Dock="Right" Content="Fechar" Appearance="Primary" IsCancel="True" IsDefault="True" Click="OnClose" MinWidth="96" />
            </DockPanel>
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
