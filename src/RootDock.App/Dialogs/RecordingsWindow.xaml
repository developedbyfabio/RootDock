<ui:FluentWindow x:Class="RootDock.App.Dialogs.RecordingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Gravações de terminal"
                 Width="820" Height="560" MinWidth="620" MinHeight="360"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 ShowInTaskbar="False"
                 Background="{DynamicResource RdSurface}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Title="Gravações de terminal" ShowMinimize="False" />
        <TextBlock Grid.Row="1" Margin="16,0,16,10" Foreground="{DynamicResource RdTextDim}" TextWrapping="Wrap"
                   Text="Para gravar, clique no botão de gravação (círculo) na barra das abas com o terminal aberto; clique de novo para parar. As gravações ficam no formato asciinema (.cast)." />
        <Border Grid.Row="2" Margin="16,0,16,0" Background="{DynamicResource RdPanel}" BorderBrush="{DynamicResource RdBorder}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <ListBox x:Name="List" BorderThickness="0" Background="Transparent" MouseDoubleClick="OnPlay" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="10,6" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding FileName}" FontSize="11" Foreground="{DynamicResource RdTextDim}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding When}" Foreground="{DynamicResource RdTextDim}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Duration}" Foreground="{DynamicResource RdTextDim}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding Size}" Foreground="{DynamicResource RdTextDim}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyText" Text="Nenhuma gravação ainda." Foreground="{DynamicResource RdTextDim}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Border>
        <DockPanel Grid.Row="3" Margin="16,10,16,16">
            <ui:Button Content="Abrir a pasta" Click="OnOpenFolder" Icon="{ui:SymbolIcon FolderOpen20}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Excluir..." Margin="0,0,8,0" Click="OnDelete" Icon="{ui:SymbolIcon Delete20}" />
                <ui:Button Content="Reproduzir" Appearance="Primary" Click="OnPlay" Icon="{ui:SymbolIcon Play20}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</ui:FluentWindow>
