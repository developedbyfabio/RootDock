<ui:FluentWindow x:Class="RootDock.App.Dialogs.ThemesWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Temas"
                 Width="920" Height="720" MinWidth="640" MinHeight="460"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 ShowInTaskbar="False"
                 Background="{DynamicResource RdSurface}">
    <ui:FluentWindow.Resources>
        <!-- Cartão do tema: miniatura do RootDock com as cores do tema + nome e descrição -->
        <Style x:Key="ThemeCard" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,14,14" />
            <Setter Property="Width" Value="270" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Ring" CornerRadius="10" BorderThickness="2" BorderBrush="{DynamicResource RdBorder}" Background="{DynamicResource RdPanel}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource RdGuideActive}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource RdAccent}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource RdAccent}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Title="Temas" ShowMinimize="False" />
        <DockPanel Grid.Row="1" Margin="20,0,20,12">
            <CheckBox x:Name="WithTerminal" DockPanel.Dock="Right" IsChecked="True" Content="Usar também as cores de terminal do tema"
                      ToolTip="Desmarcado: o terminal mantém o esquema de cores atual (Exibir → Aparência do terminal)" />
            <TextBlock Foreground="{DynamicResource RdTextDim}" VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="Clique num tema para aplicar: muda a janela, as abas, o editor e o terminal na hora." />
        </DockPanel>

        <ScrollViewer Grid.Row="2" Margin="20,0,6,0" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <ItemsControl x:Name="Cards">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource ThemeCard}" Click="OnPick" Tag="{Binding Id}" AutomationProperties.Name="{Binding Name}">
                            <StackPanel>
                                <!-- Miniatura -->
                                <Border Height="132" Margin="8,8,8,0" CornerRadius="6" Background="{Binding Background}" ClipToBounds="True"
                                        BorderBrush="{Binding Border}" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="18" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Border Background="{Binding Surface}" BorderBrush="{Binding Border}" BorderThickness="0,0,0,1">
                                            <StackPanel Orientation="Horizontal" Margin="6,0" VerticalAlignment="Center">
                                                <Rectangle Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="{Binding Accent}" Margin="0,0,8,0" />
                                                <Rectangle Width="22" Height="4" RadiusX="2" RadiusY="2" Fill="{Binding TextDim}" Margin="0,0,6,0" />
                                                <Rectangle Width="18" Height="4" RadiusX="2" RadiusY="2" Fill="{Binding TextDim}" Margin="0,0,6,0" />
                                                <Rectangle Width="20" Height="4" RadiusX="2" RadiusY="2" Fill="{Binding TextDim}" />
                                            </StackPanel>
                                        </Border>
                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="62" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Background="{Binding Surface}" BorderBrush="{Binding Border}" BorderThickness="0,0,1,0">
                                                <StackPanel Margin="7,8,7,0">
                                                    <Rectangle Height="4" RadiusX="2" RadiusY="2" Fill="{Binding Text}" Margin="0,0,10,7" />
                                                    <Border Background="{Binding Selection}" CornerRadius="2" Padding="2" Margin="-2,0,0,5">
                                                        <Rectangle Height="4" RadiusX="2" RadiusY="2" Fill="{Binding Text}" Margin="0,0,6,0" />
                                                    </Border>
                                                    <Rectangle Height="4" RadiusX="2" RadiusY="2" Fill="{Binding TextDim}" Margin="0,0,14,7" />
                                                    <Rectangle Height="4" RadiusX="2" RadiusY="2" Fill="{Binding TextDim}" Margin="0,0,4,7" />
                                                    <Rectangle Height="4" RadiusX="2" RadiusY="2" Fill="{Binding TextDim}" Margin="0,0,18,0" />
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="1" Background="{Binding TermBackground}">
                                                <StackPanel Margin="8,9,8,0">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                                        <Rectangle Width="34" Height="4" RadiusX="2" RadiusY="2" Fill="{Binding TermGreen}" Margin="0,0,4,0" />
                                                        <Rectangle Width="26" Height="4" RadiusX="2" RadiusY="2" Fill="{Binding TermBlue}" Margin="0,0,4,0" />
                                                        <Rectangle Width="40" Height="4" RadiusX="2" RadiusY="2" Fill="{Binding TermForeground}" />
                                                    </StackPanel>
                                                    <Rectangle Width="110" Height="4" RadiusX="2" RadiusY="2" Fill="{Binding TermForeground}" HorizontalAlignment="Left" Margin="0,0,0,7" Opacity="0.75" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                                        <Rectangle Width="30" Height="4" RadiusX="2" RadiusY="2" Fill="{Binding TermYellow}" Margin="0,0,4,0" />
                                                        <Rectangle Width="70" Height="4" RadiusX="2" RadiusY="2" Fill="{Binding TermForeground}" Opacity="0.75" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                                        <Rectangle Width="30" Height="4" RadiusX="2" RadiusY="2" Fill="{Binding TermRed}" Margin="0,0,4,0" />
                                                        <Rectangle Width="54" Height="4" RadiusX="2" RadiusY="2" Fill="{Binding TermForeground}" Opacity="0.75" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Rectangle Width="34" Height="4" RadiusX="2" RadiusY="2" Fill="{Binding TermGreen}" Margin="0,0,4,0" />
                                                        <Rectangle Width="6" Height="8" Fill="{Binding Accent}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        <!-- Linhas de tubo (temas de computador antigo) -->
                                        <Rectangle Grid.RowSpan="2" Visibility="{Binding ScanlinesVisibility}" Opacity="0.35">
                                            <Rectangle.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,3" MappingMode="Absolute" SpreadMethod="Repeat">
                                                    <GradientStop Offset="0" Color="Transparent" />
                                                    <GradientStop Offset="0.6" Color="Transparent" />
                                                    <GradientStop Offset="0.6" Color="#88000000" />
                                                    <GradientStop Offset="1" Color="#88000000" />
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                    </Grid>
                                </Border>
                                <!-- Nome e descrição -->
                                <DockPanel Margin="12,10,12,12">
                                    <Border DockPanel.Dock="Right" Visibility="{Binding CurrentVisibility}" CornerRadius="9" Padding="8,1"
                                            Background="{DynamicResource RdAccentSoft}" VerticalAlignment="Top">
                                        <TextBlock Text="em uso" FontSize="11" Foreground="{DynamicResource RdAccent}" />
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource RdText}" />
                                        <TextBlock Text="{Binding Description}" Margin="0,3,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource RdTextDim}" />
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <DockPanel Grid.Row="3" Margin="20,10,20,16">
            <TextBlock Foreground="{DynamicResource RdTextDim}" FontSize="12" VerticalAlignment="Center"
                       Text="Também em Exibir → Tema. As cores do terminal podem ser ajustadas em Exibir → Aparência do terminal." />
            <ui:Button Content="Fechar" Appearance="Primary" HorizontalAlignment="Right" IsCancel="True" Click="OnClose" MinWidth="96" />
        </DockPanel>
    </Grid>
</ui:FluentWindow>
