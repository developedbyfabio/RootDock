<ui:FluentWindow x:Class="RootDock.App.Dialogs.TunnelsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Túneis"
                 Width="680"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 ShowInTaskbar="False"
                 Background="{DynamicResource RdSurface}">
    <StackPanel>
        <ui:TitleBar Title="Túneis (redirecionamento de portas)" ShowMaximize="False" ShowMinimize="False" />
        <StackPanel Margin="24,6,24,20">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="ArrowSwap20" FontSize="22" Foreground="{DynamicResource RdAccent}" VerticalAlignment="Center" />
                <TextBlock x:Name="HeaderText" Margin="10,0,0,0" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <TextBlock x:Name="ConnectionText" Margin="32,2,0,0" Foreground="{DynamicResource RdTextDim}" TextWrapping="Wrap" />

            <Border Margin="0,14,0,0" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource RdBorder}" Background="{DynamicResource RdBackground}">
                <StackPanel>
                    <StackPanel x:Name="Rows" />
                    <TextBlock x:Name="EmptyText" Margin="14,14" Foreground="{DynamicResource RdTextDim}" TextWrapping="Wrap"
                               Text="Nenhum túnel nesta sessão. Crie um abaixo: por exemplo, para acessar o banco de dados do servidor pelo seu computador." />
                </StackPanel>
            </Border>

            <!-- Formulário -->
            <TextBlock x:Name="FormTitle" Text="Novo túnel" Margin="0,18,0,6" FontWeight="SemiBold" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="KindBox" SelectionChanged="OnKindChanged">
                    <ComboBoxItem Content="Local (-L): porta aqui → destino" Tag="Local" />
                    <ComboBoxItem Content="Remoto (-R): porta no servidor → aqui" Tag="Remote" />
                    <ComboBoxItem Content="Dinâmico (-D): proxy SOCKS" Tag="Dynamic" />
                </ComboBox>
                <ui:TextBox x:Name="NameBox" Grid.Column="2" PlaceholderText="Nome (opcional), ex.: MySQL produção" />
            </Grid>
            <TextBlock x:Name="KindHelp" Margin="0,6,0,8" FontSize="12" Foreground="{DynamicResource RdTextDim}" TextWrapping="Wrap" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="80" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="BindLabel" Text="Escutar em" Width="110" VerticalAlignment="Center" />
                <ui:TextBox x:Name="BindHostBox" Grid.Column="1" Text="127.0.0.1" TextChanged="OnBindChanged" />
                <TextBlock Grid.Column="2" Text=":" Margin="6,0" VerticalAlignment="Center" />
                <ui:TextBox x:Name="BindPortBox" Grid.Column="3" PlaceholderText="porta" />

                <TextBlock x:Name="TargetLabel" Grid.Row="1" Text="Destino" VerticalAlignment="Center" Margin="0,8,0,0" />
                <ui:TextBox x:Name="TargetHostBox" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" Text="127.0.0.1" />
                <TextBlock x:Name="TargetColon" Grid.Row="1" Grid.Column="2" Text=":" Margin="6,8,6,0" VerticalAlignment="Center" />
                <ui:TextBox x:Name="TargetPortBox" Grid.Row="1" Grid.Column="3" Margin="0,8,0,0" PlaceholderText="porta" />
            </Grid>

            <TextBlock x:Name="ExposedWarning" Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource RdStaging}" TextWrapping="Wrap" Visibility="Collapsed"
                       Text="Atenção: escutando em todas as interfaces, outros computadores da rede também podem usar este túnel." />

            <DockPanel Margin="0,10,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ui:Button x:Name="CancelEditButton" Content="Cancelar edição" Margin="0,0,8,0" Click="OnCancelEdit" Visibility="Collapsed" />
                    <ui:Button x:Name="SaveButton" Content="Salvar túnel" Appearance="Primary" Click="OnSave" />
                </StackPanel>
                <CheckBox x:Name="AutoStartBox" IsChecked="True" Content="Abrir sozinho ao conectar a sessão" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock x:Name="FormError" Margin="0,6,0,0" Foreground="{DynamicResource RdProd}" TextWrapping="Wrap" Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <ui:Button Content="Fechar" IsCancel="True" MinWidth="96" Click="OnClose" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
