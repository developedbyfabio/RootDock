<ui:FluentWindow x:Class="RootDock.App.Dialogs.FileManagerWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:RootDock.App.Views"
                 Title="Gerenciador de arquivos"
                 Width="1280" Height="800" MinWidth="960" MinHeight="560"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 ShowInTaskbar="True"
                 Background="{DynamicResource RdSurface}">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />
        <views:InverseBoolVisibilityConverter x:Key="InverseBoolVis" />

        <DataTemplate x:Key="RowTemplate">
            <Grid ToolTip="{Binding ToolTip}" Opacity="{Binding Opacity}" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="86" />
                    <ColumnDefinition Width="118" />
                    <ColumnDefinition Width="104" />
                </Grid.ColumnDefinitions>
                <Grid Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Image Source="{Binding IconImage}" Width="16" Height="16" />
                    <ui:SymbolIcon Symbol="{Binding Icon}" Foreground="{Binding IconBrush}" FontSize="16" Visibility="{Binding GlyphVisibility}" />
                </Grid>
                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding SizeText}" Foreground="{DynamicResource RdTextDim}" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center" FontSize="12" />
                <TextBlock Grid.Column="3" Text="{Binding ModifiedText}" Foreground="{DynamicResource RdTextDim}" VerticalAlignment="Center" FontSize="12" />
                <TextBlock Grid.Column="4" Text="{Binding Extra}" Foreground="{Binding ExtraBrush}" VerticalAlignment="Center" FontSize="11.5" TextTrimming="CharacterEllipsis"
                           FontFamily="{Binding ExtraFont}" />
            </Grid>
        </DataTemplate>

        <Style x:Key="Rows" TargetType="ListBoxItem" BasedOn="{StaticResource RdListItem}">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar x:Name="TitleBar" Title="Gerenciador de arquivos" />

        <!-- Ações gerais -->
        <DockPanel Grid.Row="1" Margin="16,2,16,10">
            <StackPanel Orientation="Horizontal">
                <ui:Button Content="Comparar as pastas" Icon="{ui:SymbolIcon ArrowSwap20}" Margin="0,0,8,0" Click="OnCompare"
                           ToolTip="Marca o que só existe de um lado, o que é diferente e o que é igual" />
                <ui:Button Content="Sincronizar → servidor" Icon="{ui:SymbolIcon ArrowUpload20}" Margin="0,0,8,0" Click="OnSyncUp"
                           ToolTip="Envia (com subpastas) o que falta ou mudou no computador. Não apaga nada no servidor." />
                <ui:Button Content="Sincronizar ← servidor" Icon="{ui:SymbolIcon ArrowDownload20}" Click="OnSyncDown"
                           ToolTip="Baixa (com subpastas) o que falta ou mudou no servidor. Não apaga nada no computador." />
            </StackPanel>
            <TextBlock x:Name="CompareSummary" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource RdTextDim}" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <!-- Duas colunas -->
        <Grid Grid.Row="2" Margin="16,0,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Este computador -->
            <Border Background="{DynamicResource RdPanel}" BorderBrush="{DynamicResource RdBorder}" BorderThickness="1" CornerRadius="8">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="10,8,10,6">
                        <DockPanel Margin="0,0,0,6">
                            <ui:SymbolIcon Symbol="Laptop20" FontSize="16" Margin="0,0,6,0" Foreground="{DynamicResource RdAccent}" />
                            <TextBlock Text="Este computador" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <ComboBox x:Name="PlacesBox" Width="190" HorizontalAlignment="Right" SelectionChanged="OnPlace" ToolTip="Lugares e unidades" />
                        </DockPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:Button Icon="{ui:SymbolIcon ArrowUp20}" Appearance="Transparent" Padding="6" Click="OnLocalUp" ToolTip="Pasta acima (Backspace)" />
                            <ui:TextBox Grid.Column="1" x:Name="LocalPathBox" FontFamily="Cascadia Mono, Consolas" FontSize="12" Padding="8,5" KeyDown="OnLocalPathKey" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <ui:Button Icon="{ui:SymbolIcon ArrowClockwise20}" Appearance="Transparent" Padding="6" Click="OnLocalRefresh" ToolTip="Atualizar (F5)" />
                                <ui:Button AutomationProperties.Name="Nova pasta no computador" Icon="{ui:SymbolIcon FolderAdd20}" Appearance="Transparent" Padding="6" Click="OnLocalNewFolder" ToolTip="Nova pasta (F7)" />
                                <ui:Button AutomationProperties.Name="Renomear no computador" Icon="{ui:SymbolIcon Edit20}" Appearance="Transparent" Padding="6" Click="OnLocalRename" ToolTip="Renomear (F2)" />
                                <ui:Button AutomationProperties.Name="Excluir no computador" Icon="{ui:SymbolIcon Delete20}" Appearance="Transparent" Padding="6" Click="OnLocalDelete" ToolTip="Mover para a Lixeira (Delete)" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" x:Name="LocalFooter" Margin="10,4,10,6" Foreground="{DynamicResource RdTextDim}" FontSize="11.5" />
                    <ListBox x:Name="LocalList" FocusVisualStyle="{x:Null}" SelectionMode="Extended" ItemTemplate="{StaticResource RowTemplate}" ItemContainerStyle="{StaticResource Rows}"
                             BorderThickness="0" Background="Transparent" AllowDrop="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseDoubleClick="OnLocalOpen" KeyDown="OnLocalKey" PreviewMouseLeftButtonDown="OnDragStart" PreviewMouseMove="OnDragMove"
                             DragOver="OnDragOver" Drop="OnLocalDrop" ContextMenuOpening="OnLocalMenu">
                        <ListBox.ContextMenu>
                            <ContextMenu />
                        </ListBox.ContextMenu>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Enviar / baixar -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <ui:Button AutomationProperties.Name="Enviar para o servidor" Icon="{ui:SymbolIcon ArrowRight24}" Appearance="Primary" Padding="10" Margin="0,0,0,10" Click="OnUpload"
                           ToolTip="Enviar os selecionados do computador para a pasta do servidor (ou arraste)" />
                <ui:Button AutomationProperties.Name="Baixar para o computador" Icon="{ui:SymbolIcon ArrowLeft24}" Padding="10" Click="OnDownload"
                           ToolTip="Baixar os selecionados do servidor para a pasta do computador (ou arraste)" />
            </StackPanel>

            <!-- Servidor -->
            <Border Grid.Column="2" Background="{DynamicResource RdPanel}" BorderBrush="{DynamicResource RdBorder}" BorderThickness="1" CornerRadius="8">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="10,8,10,6">
                        <DockPanel Margin="0,0,0,6">
                            <ui:SymbolIcon Symbol="Server20" FontSize="16" Margin="0,0,6,0" Foreground="{DynamicResource RdAccent}" />
                            <TextBlock x:Name="RemoteTitle" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:Button Icon="{ui:SymbolIcon ArrowUp20}" Appearance="Transparent" Padding="6" Click="OnRemoteUp" ToolTip="Pasta acima (Backspace)" />
                            <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon Home20}" Appearance="Transparent" Padding="6" Click="OnRemoteHome" ToolTip="Pasta pessoal" />
                            <ui:TextBox Grid.Column="2" x:Name="RemotePathBox" FontFamily="Cascadia Mono, Consolas" FontSize="12" Padding="8,5" KeyDown="OnRemotePathKey" />
                            <StackPanel Grid.Column="3" Orientation="Horizontal">
                                <ui:Button Icon="{ui:SymbolIcon ArrowClockwise20}" Appearance="Transparent" Padding="6" Click="OnRemoteRefresh" ToolTip="Atualizar (F5)" />
                                <ui:Button AutomationProperties.Name="Nova pasta no servidor" Icon="{ui:SymbolIcon FolderAdd20}" Appearance="Transparent" Padding="6" Click="OnRemoteNewFolder" ToolTip="Nova pasta (F7)" />
                                <ui:Button AutomationProperties.Name="Renomear no servidor" Icon="{ui:SymbolIcon Edit20}" Appearance="Transparent" Padding="6" Click="OnRemoteRename" ToolTip="Renomear (F2)" />
                                <ui:Button AutomationProperties.Name="Excluir no servidor" Icon="{ui:SymbolIcon Delete20}" Appearance="Transparent" Padding="6" Click="OnRemoteDelete" ToolTip="Excluir do servidor (Delete). Não há lixeira." />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" x:Name="RemoteFooter" Margin="10,4,10,6" Foreground="{DynamicResource RdTextDim}" FontSize="11.5" />
                    <ListBox x:Name="RemoteList" FocusVisualStyle="{x:Null}" SelectionMode="Extended" ItemTemplate="{StaticResource RowTemplate}" ItemContainerStyle="{StaticResource Rows}"
                             BorderThickness="0" Background="Transparent" AllowDrop="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseDoubleClick="OnRemoteOpen" KeyDown="OnRemoteKey" PreviewMouseLeftButtonDown="OnDragStart" PreviewMouseMove="OnDragMove"
                             DragOver="OnDragOver" Drop="OnRemoteDrop" ContextMenuOpening="OnRemoteMenu">
                        <ListBox.ContextMenu>
                            <ContextMenu />
                        </ListBox.ContextMenu>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Transferências e histórico -->
        <Border Grid.Row="3" Margin="16,10,16,16" Background="{DynamicResource RdPanel}" BorderBrush="{DynamicResource RdBorder}" BorderThickness="1" CornerRadius="8" Padding="10,8" Height="190">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <RadioButton x:Name="QueueTab" Content="Fila" GroupName="Bottom" IsChecked="True" Checked="OnBottomTab" MinWidth="0" Margin="0,0,14,0" />
                    <RadioButton x:Name="HistoryTab" Content="Histórico de transferências" GroupName="Bottom" Checked="OnBottomTab" MinWidth="0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button x:Name="PauseAllButton" Content="Pausar tudo" Padding="8,2" FontSize="12" Margin="0,0,6,0" Click="OnPauseAll" />
                        <ui:Button Content="Limpar concluídas" Padding="8,2" FontSize="12" Click="OnClearFinished" />
                    </StackPanel>
                </DockPanel>
                <Grid>
                    <ItemsControl x:Name="QueueList">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="280" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding DirectionGlyph}" Foreground="{DynamicResource RdAccent}" FontWeight="Bold" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Server}" Foreground="{DynamicResource RdTextDim}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <ProgressBar Height="4" Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}" />
                                        <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource RdTextDim}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <ui:Button Icon="{ui:SymbolIcon Pause16}" Appearance="Transparent" Padding="4" MinWidth="0" ToolTip="Pausar"
                                                   Command="{Binding PauseCommand}" Visibility="{Binding CanPause, Converter={StaticResource BoolVis}}" />
                                        <ui:Button Icon="{ui:SymbolIcon Play16}" Appearance="Transparent" Padding="4" MinWidth="0" ToolTip="Retomar"
                                                   Command="{Binding ResumeCommand}" Visibility="{Binding CanResume, Converter={StaticResource BoolVis}}" />
                                        <ui:Button Icon="{ui:SymbolIcon Dismiss16}" Appearance="Transparent" Padding="4" MinWidth="0" ToolTip="Cancelar"
                                                   Command="{Binding CancelCommand}" Visibility="{Binding CanPause, Converter={StaticResource BoolVis}}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="QueueEmpty" Text="Nenhuma transferência agora. Arraste arquivos de um lado para o outro, ou use as setas no meio."
                               Foreground="{DynamicResource RdTextDim}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <ListBox x:Name="HistoryList" Visibility="Collapsed" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="160" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding When}" Foreground="{DynamicResource RdTextDim}" FontSize="12" />
                                    <TextBlock Grid.Column="1" Text="{Binding Glyph}" Foreground="{DynamicResource RdAccent}" FontWeight="Bold" />
                                    <TextBlock Grid.Column="2" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" Text="{Binding Server}" Foreground="{DynamicResource RdTextDim}" TextTrimming="CharacterEllipsis" FontSize="12" />
                                    <TextBlock Grid.Column="4" Text="{Binding Size}" Foreground="{DynamicResource RdTextDim}" FontSize="12" />
                                    <TextBlock Grid.Column="5" Text="{Binding Result}" Foreground="{Binding ResultBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
