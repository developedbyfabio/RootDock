<ui:FluentWindow x:Class="RootDock.App.Dialogs.HistoryWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Histórico de comandos"
                 Width="960" Height="640" MinWidth="680" MinHeight="400"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 ShowInTaskbar="False"
                 Background="{DynamicResource RdSurface}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Title="Histórico de comandos" ShowMinimize="False" />

        <Grid Grid.Row="1" Margin="16,4,16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox x:Name="SearchBox" PlaceholderText="Buscar em todos os comandos: nginx, restart, docker logs, nome do servidor..."
                        Icon="{ui:SymbolIcon Search20}" ClearButtonEnabled="True" TextChanged="OnSearch" PreviewKeyDown="OnSearchKey" />
            <ComboBox Grid.Column="1" x:Name="ScopeBox" Width="260" Margin="10,0,0,0" SelectionChanged="OnScopeChanged" />
        </Grid>

        <Border Grid.Row="2" Margin="16,0,16,0" Background="{DynamicResource RdPanel}" BorderBrush="{DynamicResource RdBorder}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <ListBox x:Name="List" BorderThickness="0" Background="Transparent" MouseDoubleClick="OnDoubleClick" PreviewKeyDown="OnListKey"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="10,5" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ToolTip="{Binding Tooltip}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="96" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Command}" FontFamily="Cascadia Mono, Consolas" FontSize="12.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Session}" Foreground="{DynamicResource RdTextDim}" TextTrimming="CharacterEllipsis" Margin="12,0,0,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding When}" Foreground="{DynamicResource RdTextDim}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="460"
                           Foreground="{DynamicResource RdTextDim}" />
            </Grid>
        </Border>

        <DockPanel Grid.Row="3" Margin="16,10,16,16">
            <ui:Button DockPanel.Dock="Left" Content="Limpar histórico..." Click="OnClear" />
            <TextBlock x:Name="CountText" DockPanel.Dock="Left" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource RdTextDim}" FontSize="12" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Copiar" Margin="0,0,8,0" Click="OnCopy" Icon="{ui:SymbolIcon Copy20}" />
                <ui:Button Content="Executar em vários..." Margin="0,0,8,0" Click="OnMultiExec" Icon="{ui:SymbolIcon ServerMultiple20}" />
                <ui:Button Content="Colar no terminal" Appearance="Primary" Click="OnPaste" Icon="{ui:SymbolIcon WindowConsole20}"
                           ToolTip="Coloca o comando no terminal ativo sem executar (Enter)" />
            </StackPanel>
        </DockPanel>
    </Grid>
</ui:FluentWindow>
