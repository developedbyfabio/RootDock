<UserControl x:Class="RootDock.App.Views.ServerStatusBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:remote="clr-namespace:RootDock.App.Remote">
    <UserControl.Resources>
        <Style x:Key="Segment" TargetType="Border">
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="BorderBrush" Value="{DynamicResource RdBorder}" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="250" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource RdTextDim}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource RdText}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="MiniBar" TargetType="ProgressBar">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="4" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource RdBorder}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Button x:Name="BarButton" Click="OnToggleDetails" Background="Transparent" BorderThickness="0" Padding="0"
                HorizontalContentAlignment="Left" Cursor="Hand" ToolTip="Clique para ver detalhes do servidor"
                FocusVisualStyle="{x:Null}">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Button.Template>
            <StackPanel Orientation="Horizontal" Height="24">
                <!-- Servidor -->
                <Border Style="{StaticResource Segment}" ToolTip="{Binding SystemText}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Server20" FontSize="14" Foreground="{DynamicResource RdAccent}" Margin="0,0,6,0" />
                        <TextBlock Style="{StaticResource Value}" Text="{Binding Hostname}" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>

                <!-- CPU -->
                <Border Style="{StaticResource Segment}" ToolTip="{Binding LoadText}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Label}" Text="CPU" />
                        <TextBlock Style="{StaticResource Value}" Text="{Binding CpuText}" Foreground="{Binding CpuBrush}" MinWidth="30" />
                        <Border Background="{DynamicResource RdTrack}" CornerRadius="2" Margin="6,0,0,0" VerticalAlignment="Center">
                            <Canvas Width="64" Height="16" ClipToBounds="True">
                                <Polygon Points="{Binding CpuPoints}" Fill="{Binding CpuBrush}" Opacity="0.55" />
                            </Canvas>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Memória -->
                <Border Style="{StaticResource Segment}" ToolTip="{Binding SwapText}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Label}" Text="RAM" />
                        <TextBlock Style="{StaticResource Value}" Text="{Binding MemText}" />
                        <ProgressBar Style="{StaticResource MiniBar}" Value="{Binding MemPercent, Mode=OneWay}" Foreground="{Binding MemBrush}" />
                    </StackPanel>
                </Border>

                <!-- Rede -->
                <Border Style="{StaticResource Segment}" ToolTip="Tráfego de rede (enviado ↑ / recebido ↓), sem interfaces virtuais">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Value}" Text="↑" Foreground="{DynamicResource RdDev}" Margin="0,0,3,0" />
                        <TextBlock Style="{StaticResource Value}" Text="{Binding UpText}" MinWidth="62" />
                        <TextBlock Style="{StaticResource Value}" Text="↓" Foreground="{DynamicResource RdAccent}" Margin="6,0,3,0" />
                        <TextBlock Style="{StaticResource Value}" Text="{Binding DownText}" MinWidth="62" />
                        <Border Background="{DynamicResource RdTrack}" CornerRadius="2" Margin="4,0,0,0" VerticalAlignment="Center">
                            <Canvas Width="64" Height="16" ClipToBounds="True">
                                <Polygon Points="{Binding RxPoints}" Fill="{DynamicResource RdAccent}" Opacity="0.5" />
                                <Polygon Points="{Binding TxPoints}" Fill="{DynamicResource RdDev}" Opacity="0.5" />
                            </Canvas>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Discos principais -->
                <ItemsControl ItemsSource="{Binding MainDisks}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type remote:DiskRow}">
                            <Border Style="{StaticResource Segment}" ToolTip="{Binding ToolTip}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="HardDrive20" FontSize="13" Foreground="{DynamicResource RdTextDim}" Margin="0,0,6,0" />
                                    <TextBlock Style="{StaticResource Value}" Text="{Binding Text}" />
                                    <ProgressBar Style="{StaticResource MiniBar}" Width="34" Value="{Binding Percent, Mode=OneWay}" Foreground="{Binding Brush}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Tempo ligado -->
                <Border Style="{StaticResource Segment}" ToolTip="Tempo desde o último reinício do servidor">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Clock20" FontSize="13" Foreground="{DynamicResource RdTextDim}" Margin="0,0,6,0" />
                        <TextBlock Style="{StaticResource Value}" Text="{Binding UptimeText}" />
                    </StackPanel>
                </Border>

                <!-- Usuário -->
                <Border Style="{StaticResource Segment}" BorderThickness="0" ToolTip="Usuário desta sessão (sessões abertas dele no servidor)">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Person20" FontSize="13" Foreground="{DynamicResource RdTextDim}" Margin="0,0,6,0" />
                        <TextBlock Style="{StaticResource Value}" Text="{Binding UserText}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Button>

        <!-- Detalhes -->
        <Popup x:Name="DetailsPopup" PlacementTarget="{Binding ElementName=BarButton}" Placement="Top" StaysOpen="False"
               AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="-6">
            <Border Background="{DynamicResource RdSurface}" BorderBrush="{DynamicResource RdBorder}" BorderThickness="1"
                    CornerRadius="8" Padding="18,14" Width="560">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.45" />
                </Border.Effect>
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding UpdatedText}" Foreground="{DynamicResource RdTextDim}" FontSize="11" VerticalAlignment="Bottom" />
                        <TextBlock Text="{Binding Hostname}" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource RdText}" />
                    </DockPanel>
                    <TextBlock Text="{Binding SystemText}" Foreground="{DynamicResource RdTextDim}" Margin="0,2,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding IpText}" Foreground="{DynamicResource RdTextDim}" Margin="0,2,0,12" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" />

                    <UniformGrid Columns="4" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="CPU" Foreground="{DynamicResource RdTextDim}" FontSize="11" />
                            <TextBlock Text="{Binding CpuText}" Foreground="{Binding CpuBrush}" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding LoadText}" Foreground="{DynamicResource RdTextDim}" FontSize="11" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Memória" Foreground="{DynamicResource RdTextDim}" FontSize="11" />
                            <TextBlock Text="{Binding MemText}" Foreground="{Binding MemBrush}" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,2" />
                            <TextBlock Text="{Binding SwapText}" Foreground="{DynamicResource RdTextDim}" FontSize="11" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Rede" Foreground="{DynamicResource RdTextDim}" FontSize="11" />
                            <TextBlock Foreground="{DynamicResource RdText}" FontSize="13" Margin="0,4,0,0">
                                <Run Text="↑ " Foreground="{DynamicResource RdDev}" /><Run Text="{Binding UpText, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Foreground="{DynamicResource RdText}" FontSize="13">
                                <Run Text="↓ " Foreground="{DynamicResource RdAccent}" /><Run Text="{Binding DownText, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Ligado há" Foreground="{DynamicResource RdTextDim}" FontSize="11" />
                            <TextBlock Text="{Binding UptimeText}" Foreground="{DynamicResource RdText}" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,2" />
                            <TextBlock Text="{Binding UserText}" Foreground="{DynamicResource RdTextDim}" FontSize="11" />
                        </StackPanel>
                    </UniformGrid>

                    <TextBlock Text="Discos" Foreground="{DynamicResource RdTextDim}" FontSize="11" Margin="0,0,0,4" />
                    <ItemsControl ItemsSource="{Binding AllDisks}" Margin="0,0,0,14">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type remote:DiskRow}">
                                <Grid Margin="0,2" ToolTip="{Binding ToolTip}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="44" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Mount}" Foreground="{DynamicResource RdText}" TextTrimming="CharacterEllipsis" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                                    <ProgressBar Grid.Column="1" Height="6" Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}" Foreground="{Binding Brush}"
                                                 Background="{DynamicResource RdBorder}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding Percent, StringFormat={}{0:0}%}" Foreground="{DynamicResource RdText}" HorizontalAlignment="Right" FontSize="12" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Processos que mais usam CPU" Foreground="{DynamicResource RdTextDim}" FontSize="11" Margin="0,0,0,4" />
                    <ItemsControl ItemsSource="{Binding Processes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type remote:ProcessRow}">
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="64" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Command}" Foreground="{DynamicResource RdText}" TextTrimming="CharacterEllipsis" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                                    <TextBlock Grid.Column="1" Text="{Binding User}" Foreground="{DynamicResource RdTextDim}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding Cpu, StringFormat=CPU {0}}" Foreground="{DynamicResource RdText}" FontSize="12" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="3" Text="{Binding Memory, StringFormat=RAM {0}}" Foreground="{DynamicResource RdTextDim}" FontSize="12" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="4" Text="{Binding Pid, StringFormat=pid {0}}" Foreground="{DynamicResource RdTextDim}" FontSize="11" HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
