<UserControl x:Class="RootDock.App.Views.CommandsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:RootDock.App.Views"
             xmlns:vm="clr-namespace:RootDock.App.ViewModels">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />
        <views:NotEmptyVisibilityConverter x:Key="NotEmpty" />

        <Style x:Key="ActionButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Margin" Value="1,0,0,0" />
        </Style>

        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="Margin" Value="6,1,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Cartão de um comando (com uma linha separando do anterior: dá para ver onde cada um começa) -->
        <DataTemplate x:Key="CommandCard" DataType="{x:Type vm:CommandItemViewModel}">
            <StackPanel>
            <Border x:Name="Separator" Height="1" Margin="10,3,8,3" Background="{DynamicResource RdBorder}" SnapsToDevicePixels="True" />
            <Border x:Name="Card" CornerRadius="6" Padding="10,7,6,8" Background="Transparent" Cursor="Hand"
                    BorderThickness="1" BorderBrush="Transparent"
                    MouseLeftButtonUp="OnCommandClick" PreviewMouseRightButtonUp="OnCommandRightClick">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Título, selos e ações -->
                    <DockPanel>
                        <StackPanel x:Name="Actions" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="4,-3,0,0" Opacity="0">
                            <ui:Button Style="{StaticResource ActionButton}" Click="OnFavorite" ToolTip="Favoritar">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Star20" Filled="{Binding IsFavorite}" Foreground="{DynamicResource RdStaging}" />
                                </ui:Button.Icon>
                            </ui:Button>
                            <ui:Button Style="{StaticResource ActionButton}" Icon="{ui:SymbolIcon Copy20}" Click="OnCopy" ToolTip="Copiar o comando" />
                            <ui:Button Style="{StaticResource ActionButton}" Icon="{ui:SymbolIcon ClipboardPaste20}" Click="OnPaste" ToolTip="Colocar no terminal sem executar (para revisar)"
                                       Visibility="{Binding CanPaste, Converter={StaticResource BoolVis}}" />
                            <ui:Button Style="{StaticResource ActionButton}" Click="OnRun" ToolTip="Executar no terminal">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Play20" Filled="True" Foreground="{DynamicResource RdDev}" />
                                </ui:Button.Icon>
                            </ui:Button>
                        </StackPanel>
                        <WrapPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource RdText}" TextWrapping="Wrap" />
                            <Border Style="{StaticResource Badge}" Background="{DynamicResource RdWarnBg}" Visibility="{Binding IsCaution, Converter={StaticResource BoolVis}}"
                                    ToolTip="Altera algo no servidor: pede confirmação antes de executar">
                                <TextBlock Text="cuidado" FontSize="10.5" Foreground="{DynamicResource RdStaging}" />
                            </Border>
                            <Border Style="{StaticResource Badge}" Background="{DynamicResource RdChip}" Visibility="{Binding IsSudo, Converter={StaticResource BoolVis}}"
                                    ToolTip="Precisa de permissão de administrador (pode pedir sua senha)">
                                <TextBlock Text="sudo" FontSize="10.5" Foreground="{DynamicResource RdTextDim}" />
                            </Border>
                            <Border Style="{StaticResource Badge}" Background="{DynamicResource RdAccentSoft}" Visibility="{Binding IsKeys, Converter={StaticResource BoolVis}}"
                                    ToolTip="Envia as teclas do atalho para o terminal">
                                <TextBlock Text="atalho" FontSize="10.5" Foreground="{DynamicResource RdAccent}" />
                            </Border>
                            <Border Style="{StaticResource Badge}" Background="{DynamicResource RdAccentSoft}" Visibility="{Binding IsRun, Converter={StaticResource BoolVis}}"
                                    ToolTip="Abre neste computador, como Win+R (numa Área de Trabalho Remota, copia para colar lá)">
                                <TextBlock Text="Win+R" FontSize="10.5" Foreground="{DynamicResource RdAccent}" />
                            </Border>
                            <Border Style="{StaticResource Badge}" Background="{DynamicResource RdChip}" Visibility="{Binding IsPowerShell, Converter={StaticResource BoolVis}}"
                                    ToolTip="Comando do PowerShell (num CMD, o RootDock o executa dentro de powershell -Command)">
                                <TextBlock Text="PowerShell" FontSize="10.5" Foreground="{DynamicResource RdTextDim}" />
                            </Border>
                            <Border Style="{StaticResource Badge}" Background="{DynamicResource RdAccentSoft}" Visibility="{Binding IsMacro, Converter={StaticResource BoolVis}}"
                                    ToolTip="Executa os passos em sequência, esperando cada comando terminar">
                                <TextBlock Text="macro" FontSize="10.5" Foreground="{DynamicResource RdAccent}" />
                            </Border>
                        </WrapPanel>
                    </DockPanel>

                    <!-- O comando -->
                    <Border Grid.Row="1" Background="{DynamicResource RdInset}" CornerRadius="4" Padding="7,3" Margin="0,6,0,0" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding Preview}" FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="{DynamicResource RdDev}" TextWrapping="Wrap" />
                    </Border>

                    <!-- O que faz -->
                    <TextBlock Grid.Row="2" Text="{Binding Description}" Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource RdTextDim}" TextWrapping="Wrap" />

                    <!-- Dica -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding HasTip, Converter={StaticResource BoolVis}}">
                        <ui:SymbolIcon Symbol="Lightbulb20" FontSize="12" Foreground="{DynamicResource RdStaging}" Margin="0,1,5,0" VerticalAlignment="Top" />
                        <TextBlock Text="{Binding Tip}" FontSize="11.5" Foreground="{DynamicResource RdTextDim}" FontStyle="Italic" TextWrapping="Wrap" MaxWidth="290" />
                    </StackPanel>

                    <!-- Campos para preencher -->
                    <Border Grid.Row="4" x:Name="Form" Tag="form" Margin="0,8,0,0" Padding="10,8" CornerRadius="6" Background="{DynamicResource RdPanel}" Cursor="Arrow"
                            Visibility="{Binding IsFormOpen, Converter={StaticResource BoolVis}}">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Params}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:CommandParamViewModel}">
                                        <StackPanel Margin="0,0,0,6">
                                            <TextBlock Text="{Binding Label}" FontSize="11.5" Foreground="{DynamicResource RdTextDim}" Margin="0,0,0,3" />
                                            <ui:TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{Binding Placeholder}"
                                                        FontFamily="Cascadia Mono, Consolas" FontSize="12" Padding="8,4" KeyDown="OnParamKey" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource RdProd}" FontSize="11.5" Margin="0,0,0,6" TextWrapping="Wrap"
                                       Visibility="{Binding Error, Converter={StaticResource NotEmpty}}" />
                            <WrapPanel>
                                <ui:Button Content="Executar" Appearance="Primary" Icon="{ui:SymbolIcon Play20}" Click="OnRun" Margin="0,0,6,4" />
                                <ui:Button Content="Só colocar" Click="OnPaste" Margin="0,0,6,4" ToolTip="Coloca no terminal sem apertar Enter" />
                                <ui:Button Content="Cancelar" Appearance="Transparent" Click="OnCancelForm" Margin="0,0,0,4" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            </StackPanel>
            <DataTemplate.Triggers>
                <!-- Primeiro da lista: sem linha em cima -->
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                    <Setter TargetName="Separator" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource RdHover}" />
                    <Setter TargetName="Actions" Property="Opacity" Value="1" />
                </Trigger>
                <DataTrigger Binding="{Binding IsFormOpen}" Value="True">
                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource RdHover}" />
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource RdFocusBorder}" />
                    <Setter TargetName="Actions" Property="Opacity" Value="1" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel Background="{DynamicResource RdSurface}">
        <!-- Cabeçalho -->
        <Grid DockPanel.Dock="Top" Margin="14,10,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="BookOpen20" FontSize="17" Foreground="{DynamicResource RdAccent}" Margin="0,0,8,0" />
                    <TextBlock Text="Comandos" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource RdText}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="SubtitleText" FontSize="11" Foreground="{DynamicResource RdTextDim}" Margin="0,2,0,0"
                           Text="Clique para executar no terminal ativo" />
            </StackPanel>
            <ui:Button Grid.Column="1" Style="{StaticResource ActionButton}" Icon="{ui:SymbolIcon Add20}" Click="OnAdd"
                       ToolTip="Cadastrar um comando seu (Meus comandos)" VerticalAlignment="Top" />
            <ui:Button Grid.Column="2" Style="{StaticResource ActionButton}" Icon="{ui:SymbolIcon Dismiss16}" Click="OnClose"
                       ToolTip="Fechar (Ctrl+Shift+L)" VerticalAlignment="Top" />
        </Grid>

        <!-- Busca -->
        <ui:TextBox DockPanel.Dock="Top" x:Name="SearchBox" Margin="10,0,10,8" Icon="{ui:SymbolIcon Search20}" ClearButtonEnabled="True"
                    PlaceholderText="Buscar: espaço, memória, logs, porta..."
                    Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnSearchKey" />

        <!-- Para onde vai o comando -->
        <Border DockPanel.Dock="Top" Margin="10,0,10,8" Padding="10,7" CornerRadius="6" Background="{DynamicResource RdHover}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="TargetDot" Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource RdTextDim}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanRun}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource RdDev}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="Enviando para " FontSize="12" Foreground="{DynamicResource RdTextDim}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding TargetText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource RdText}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                </StackPanel>
                <TextBlock Text="{Binding TargetWarning}" FontSize="11.5" Foreground="{DynamicResource RdStaging}" TextWrapping="Wrap" Margin="15,3,0,0"
                           Visibility="{Binding TargetWarning, Converter={StaticResource NotEmpty}}" />
                <!-- Sistema dos comandos: automático (pelo terminal em foco) ou escolhido -->
                <DockPanel Margin="15,7,0,0">
                    <TextBlock DockPanel.Dock="Left" Text="Sistema" FontSize="12" Foreground="{DynamicResource RdTextDim}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ComboBox x:Name="OsBox" ItemsSource="{Binding OsChoices}" SelectedItem="{Binding SelectedOsChoice}" DisplayMemberPath="Label"
                              FontSize="12" MinHeight="0" Padding="9,4" AutomationProperties.Name="Sistema dos comandos"
                              ToolTip="Automático: segue o terminal em foco (Ubuntu, RHEL/CentOS, SUSE/SLES, Windows). Escolha um sistema para fixar." />
                </DockPanel>
            </StackPanel>
        </Border>

        <TextBlock DockPanel.Dock="Top" Text="{Binding ResultSummary}" FontSize="11.5" Foreground="{DynamicResource RdTextDim}" Margin="16,0,12,4"
                   TextWrapping="Wrap" Visibility="{Binding ResultSummary, Converter={StaticResource NotEmpty}}" />

        <!-- Temas e comandos -->
        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Sections}" Margin="6,0,6,14">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:CommandCategoryViewModel}">
                        <StackPanel Margin="0,1">
                            <Border x:Name="Header" CornerRadius="6" Padding="4,0,8,0" MinHeight="32" Background="Transparent" Cursor="Hand"
                                    MouseLeftButtonUp="OnCategoryClick">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Path x:Name="Chevron" Data="M 0,0 L 4,4 L 0,8" Width="5" Height="9" Stretch="None" Stroke="{DynamicResource RdTextDim}"
                                          StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform>
                                            <RotateTransform Angle="0" />
                                        </Path.RenderTransform>
                                    </Path>
                                    <ui:SymbolIcon Grid.Column="1" Symbol="{Binding Icon}" FontSize="16" Foreground="{DynamicResource RdAccent}" Margin="2,0,9,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding Name}" FontWeight="Medium" FontSize="13.5" Foreground="{DynamicResource RdText}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <Border Grid.Column="3" CornerRadius="9" Background="{DynamicResource RdChip}" Padding="7,1" MinWidth="22" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CountText}" FontSize="11" Foreground="{DynamicResource RdTextDim}" HorizontalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Border>

                            <Border x:Name="Body" Margin="13,0,0,6" Padding="8,2,0,2" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource RdGuide}"
                                    Visibility="{Binding IsExpanded, Converter={StaticResource BoolVis}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="{DynamicResource RdTextDim}" TextWrapping="Wrap"
                                               Margin="4,4,6,4" Visibility="{Binding HasDescription, Converter={StaticResource BoolVis}}" />
                                    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource CommandCard}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <Trigger SourceName="Header" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Header" Property="Background" Value="{DynamicResource RdHover}" />
                                <Setter TargetName="Chevron" Property="Stroke" Value="{DynamicResource RdText}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                <Setter TargetName="Chevron" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="90" />
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSpecial}" Value="True">
                                <Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource RdGuideActive}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
