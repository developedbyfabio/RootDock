<UserControl x:Class="RootDock.App.Views.FilesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:RootDock.App.Views"
             xmlns:remote="clr-namespace:RootDock.App.Remote"
             xmlns:services="clr-namespace:RootDock.App.Services">
    <UserControl.Resources>
        <views:EqualsVisibilityConverter x:Key="StateIs" />
        <views:NotEmptyVisibilityConverter x:Key="NotEmpty" />
        <BooleanToVisibilityConverter x:Key="BoolVis" />
        <views:InverseBoolVisibilityConverter x:Key="InverseBoolVis" />
        <Style x:Key="ToolButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!-- Larguras das colunas: as mesmas no cabeçalho e em todas as linhas (redimensionáveis, salvas) -->
        <views:FileColumnsLayout x:Key="Columns" />

        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource RdTextDim}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Margin" Value="8,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- Divisória entre colunas do cabeçalho: arrastar muda a largura, dois cliques ajusta ao conteúdo -->
        <Style x:Key="ColumnGrip" TargetType="Thumb">
            <Setter Property="Width" Value="9" />
            <Setter Property="Margin" Value="0,0,-5,0" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Cursor" Value="SizeWE" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Panel.ZIndex" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent">
                            <Rectangle x:Name="Line" Width="1" Margin="0,5,0,4" HorizontalAlignment="Center" Fill="{DynamicResource RdBorder}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Line" Property="Fill" Value="{DynamicResource RdAccent}" />
                                <Setter TargetName="Line" Property="Width" Value="2" />
                                <Setter TargetName="Line" Property="Margin" Value="0,2" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Line" Property="Fill" Value="{DynamicResource RdAccent}" />
                                <Setter TargetName="Line" Property="Width" Value="2" />
                                <Setter TargetName="Line" Property="Margin" Value="0,2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cabeçalho clicável (ordena; clicar de novo inverte) -->
        <Style x:Key="HeaderCell" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="6,0,4,0" />
            <!-- Sem isto o botão usa a cor de texto do sistema (preta) em vez da do tema -->
            <Setter Property="Foreground" Value="{DynamicResource RdTextDim}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="3" Padding="2,3">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource RdHover}" />
                                <Setter Property="Foreground" Value="{DynamicResource RdText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Sem sessão SSH nem Área de Trabalho Remota ativa -->
        <StackPanel x:Name="Placeholder" VerticalAlignment="Center" Margin="24" Visibility="Collapsed">
            <ui:SymbolIcon Symbol="FolderOpen20" FontSize="40" Foreground="{DynamicResource RdTextDim}" HorizontalAlignment="Center" />
            <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource RdTextDim}"
                       Text="Os arquivos do servidor aparecem aqui quando um terminal SSH ou uma Área de Trabalho Remota está ativa." />
        </StackPanel>

        <!-- Área de Trabalho Remota ativa: arquivos do servidor Windows (SMB) -->
        <StackPanel x:Name="RdpCard" VerticalAlignment="Center" Margin="20" Visibility="Collapsed">
            <ui:SymbolIcon Symbol="Desktop20" FontSize="40" Foreground="{DynamicResource RdAccent}" HorizontalAlignment="Center" />
            <TextBlock x:Name="RdpCardTitle" Margin="0,12,0,0" FontWeight="SemiBold" FontSize="14" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource RdTextDim}" FontSize="12.5"
                       Text="Os arquivos deste computador e os do servidor lado a lado: arraste ou use as setas para copiar nos dois sentidos." />
            <ui:Button x:Name="RdpFilesButton" Content="Computador ↔ Servidor" Appearance="Primary"
                       HorizontalAlignment="Center" Margin="0,16,0,0" Padding="14,8" Click="OnOpenRdpFiles" />
            <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource RdTextDim}" FontSize="11"
                       Text="Usa o compartilhamento de arquivos do Windows (porta 445) com o mesmo login da Área de Trabalho Remota. Para ver as unidades (C:, D:) o usuário precisa ser administrador do servidor." />
        </StackPanel>

        <DockPanel x:Name="ContentRoot" LastChildFill="True">
            <!-- Gerenciador em duas colunas (como o WinSCP) -->
            <ui:Button x:Name="ManagerButton" DockPanel.Dock="Top" Margin="8,8,8,0" Padding="10,7" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                       Content="Computador ↔ Servidor" Click="OnOpenManager"
                       AutomationProperties.Name="Computador ↔ Servidor"
                       ToolTip="Transferir arquivos entre este computador e o servidor, em duas colunas como o WinSCP (arrastar, copiar, renomear, excluir, comparar, sincronizar)" />
            <ui:Button x:Name="ServerTransferButton" DockPanel.Dock="Top" Margin="8,6,8,0" Padding="10,7" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                       Content="Servidor ↔ Servidor" Click="OnOpenServerTransfer"
                       AutomationProperties.Name="Servidor ↔ Servidor"
                       ToolTip="Transferir arquivos e pastas deste servidor para outro (ou de outro para este), direto entre os dois quando der" />
            <!-- Caminho -->
            <Grid DockPanel.Dock="Top" Margin="8,8,8,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:Button Style="{StaticResource ToolButton}" Icon="{ui:SymbolIcon ArrowUp20}" ToolTip="Pasta acima (Backspace)" Click="OnUp" />
                <ui:Button Grid.Column="1" Style="{StaticResource ToolButton}" Icon="{ui:SymbolIcon Home20}" ToolTip="Pasta pessoal" Click="OnHome" />
                <ui:TextBox Grid.Column="2" x:Name="PathBox" Text="{Binding PathInput, UpdateSourceTrigger=PropertyChanged}"
                            FontFamily="Cascadia Mono, Consolas" FontSize="12" Padding="8,5" KeyDown="OnPathKey"
                            ToolTip="Digite um caminho e pressione Enter" />
                <ui:Button Grid.Column="3" Style="{StaticResource ToolButton}" Icon="{ui:SymbolIcon ArrowClockwise20}" ToolTip="Atualizar (F5)" Click="OnRefresh" Margin="2,0,0,0" />
            </Grid>

            <!-- Ações -->
            <DockPanel DockPanel.Dock="Top" Margin="8,0,8,4" LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <ui:Button Style="{StaticResource ToolButton}" Icon="{ui:SymbolIcon FolderAdd20}" ToolTip="Nova pasta" Click="OnNewFolder" />
                    <ui:Button Style="{StaticResource ToolButton}" Icon="{ui:SymbolIcon DocumentAdd20}" ToolTip="Novo arquivo" Click="OnNewFile" />
                    <ui:Button Style="{StaticResource ToolButton}" Icon="{ui:SymbolIcon ArrowUpload20}" ToolTip="Enviar arquivos para esta pasta (ou arraste do Windows)" Click="OnUpload" />
                    <ui:Button Style="{StaticResource ToolButton}" Icon="{ui:SymbolIcon ArrowDownload20}" ToolTip="Baixar selecionados para Downloads" Click="OnDownloadToDownloads" />
                    <ui:Button Style="{StaticResource ToolButton}" Icon="{ui:SymbolIcon WindowConsole20}" ToolTip="Ir para esta pasta no terminal (cd)" Click="OnCdHere" />
                    <ui:Button x:Name="DetailsButton" Style="{StaticResource ToolButton}" Icon="{ui:SymbolIcon TextColumnThree20}" Click="OnColumnsButton"
                               AutomationProperties.Name="Colunas"
                               ToolTip="Colunas: escolher quais aparecem, ajustar as larguras ou alargar o painel (também no botão direito sobre o cabeçalho)" />
                </StackPanel>
                <ui:TextBox x:Name="FilterBox" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged, Delay=200}" PlaceholderText="Filtrar"
                            Icon="{ui:SymbolIcon Filter20}" FontSize="12" Padding="6,4" Margin="6,0,0,0" ClearButtonEnabled="True" />
            </DockPanel>

            <!-- Rodapé: opções e transferências -->
            <StackPanel DockPanel.Dock="Bottom" Margin="8,4,8,8">
                <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource RdTextDim}" FontSize="11" Margin="2,0,0,4" />
                <CheckBox Content="Seguir a pasta do terminal" IsChecked="{Binding FollowTerminal}" FontSize="12" MinHeight="0" Padding="6,0,0,0" />
                <CheckBox Content="Mostrar arquivos ocultos" IsChecked="{Binding ShowHidden}" FontSize="12" MinHeight="0" Padding="6,0,0,0" Margin="0,2,0,0" />

                <StackPanel x:Name="TransfersPanel" Margin="0,8,0,0" Visibility="{Binding HasItems, Converter={StaticResource BoolVis}}">
                    <DockPanel Margin="0,0,0,4">
                        <ui:Button DockPanel.Dock="Right" Content="Limpar" Appearance="Transparent" Padding="6,1" FontSize="11" Command="{Binding ClearFinishedCommand}" />
                        <ui:Button DockPanel.Dock="Right" Content="Retomar tudo" Appearance="Transparent" Padding="6,1" FontSize="11" Command="{Binding ResumeAllCommand}"
                                   Visibility="{Binding IsPaused, Converter={StaticResource BoolVis}}" />
                        <ui:Button DockPanel.Dock="Right" Content="Pausar tudo" Appearance="Transparent" Padding="6,1" FontSize="11" Command="{Binding PauseAllCommand}"
                                   Visibility="{Binding IsPaused, Converter={StaticResource InverseBoolVis}}" />
                        <TextBlock Text="Transferências" Foreground="{DynamicResource RdTextDim}" FontSize="11" VerticalAlignment="Center" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Items}" MaxHeight="190"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type services:TransferItem}">
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding DirectionGlyph}" Foreground="{DynamicResource RdAccent}" FontWeight="Bold" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="12" />
                                    <StackPanel Grid.Column="2" Grid.RowSpan="2" Orientation="Horizontal" VerticalAlignment="Top">
                                        <ui:Button Icon="{ui:SymbolIcon Pause16}" Appearance="Transparent" Padding="3" MinWidth="0"
                                                   ToolTip="Pausar (o download continua de onde parou)" Command="{Binding PauseCommand}" Visibility="{Binding CanPause, Converter={StaticResource BoolVis}}" />
                                        <ui:Button Icon="{ui:SymbolIcon Play16}" Appearance="Transparent" Padding="3" MinWidth="0"
                                                   ToolTip="Retomar" Command="{Binding ResumeCommand}" Visibility="{Binding CanResume, Converter={StaticResource BoolVis}}" />
                                        <ui:Button Icon="{ui:SymbolIcon Dismiss16}" Appearance="Transparent" Padding="3" MinWidth="0"
                                                   ToolTip="Cancelar" Command="{Binding CancelCommand}" Visibility="{Binding CanPause, Converter={StaticResource BoolVis}}" />
                                    </StackPanel>
                                    <ProgressBar Grid.Row="1" Grid.Column="1" Height="3" Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}" Margin="0,3,0,2" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Detail}" Foreground="{DynamicResource RdTextDim}" FontSize="10.5" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>

            <!-- Lista com cabeçalho de colunas -->
            <Grid x:Name="ListArea">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- Cabeçalho (sempre visível): clicar ordena, arrastar a divisória muda a largura, botão direito escolhe as colunas.
                     Rola na horizontal junto com a lista. -->
                <Border x:Name="HeaderHost" BorderBrush="{DynamicResource RdBorder}" BorderThickness="0,0,0,1" Margin="4,2,4,2" Background="Transparent"
                        MouseRightButtonUp="OnHeaderRightClick">
                    <ScrollViewer x:Name="HeaderScroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                  Focusable="False" IsTabStop="False" PanningMode="None">
                        <Grid x:Name="HeaderGrid" Margin="6,0,6,2" HorizontalAlignment="Left" Height="24"
                              TextElement.FontSize="11.5" TextElement.Foreground="{DynamicResource RdTextDim}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding NameWidth, Source={StaticResource Columns}}" />
                                <ColumnDefinition Width="{Binding SizeWidth, Source={StaticResource Columns}}" />
                                <ColumnDefinition Width="{Binding ModifiedWidth, Source={StaticResource Columns}}" />
                                <ColumnDefinition Width="{Binding OwnerWidth, Source={StaticResource Columns}}" />
                                <ColumnDefinition Width="{Binding GroupWidth, Source={StaticResource Columns}}" />
                                <ColumnDefinition Width="{Binding PermissionsWidth, Source={StaticResource Columns}}" />
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource HeaderCell}" Tag="Name" Click="OnSortHeader" Margin="-2,0,6,0" HorizontalContentAlignment="Left"
                                    AutomationProperties.Name="Ordenar por nome">
                                <TextBlock TextTrimming="CharacterEllipsis"><Run Text="Nome" /><Run Text="{Binding SortName, Mode=OneWay}" FontSize="9" /></TextBlock>
                            </Button>
                            <Thumb Style="{StaticResource ColumnGrip}" Tag="Name" DragStarted="OnGripStarted" DragDelta="OnGripDelta" DragCompleted="OnGripCompleted"
                                   MouseDoubleClick="OnGripDoubleClick" />

                            <Button Grid.Column="1" Style="{StaticResource HeaderCell}" Tag="Size" Click="OnSortHeader" Margin="4,0,8,0" HorizontalContentAlignment="Right"
                                    AutomationProperties.Name="Ordenar por tamanho" Visibility="{Binding SizeVisibility, Source={StaticResource Columns}}">
                                <TextBlock TextTrimming="CharacterEllipsis"><Run Text="{Binding SortSize, Mode=OneWay}" FontSize="9" /><Run Text="Tamanho" /></TextBlock>
                            </Button>
                            <Thumb Grid.Column="1" Style="{StaticResource ColumnGrip}" Tag="Size" DragStarted="OnGripStarted" DragDelta="OnGripDelta" DragCompleted="OnGripCompleted"
                                   MouseDoubleClick="OnGripDoubleClick" Visibility="{Binding SizeVisibility, Source={StaticResource Columns}}" />

                            <Button Grid.Column="2" Style="{StaticResource HeaderCell}" Tag="Modified" Click="OnSortHeader" HorizontalContentAlignment="Left"
                                    AutomationProperties.Name="Ordenar por data de modificação" Visibility="{Binding ModifiedVisibility, Source={StaticResource Columns}}">
                                <TextBlock TextTrimming="CharacterEllipsis"><Run Text="Modificado" /><Run Text="{Binding SortModified, Mode=OneWay}" FontSize="9" /></TextBlock>
                            </Button>
                            <Thumb Grid.Column="2" Style="{StaticResource ColumnGrip}" Tag="Modified" DragStarted="OnGripStarted" DragDelta="OnGripDelta" DragCompleted="OnGripCompleted"
                                   MouseDoubleClick="OnGripDoubleClick" Visibility="{Binding ModifiedVisibility, Source={StaticResource Columns}}" />

                            <Button Grid.Column="3" Style="{StaticResource HeaderCell}" Tag="Owner" Click="OnSortHeader" HorizontalContentAlignment="Left"
                                    AutomationProperties.Name="Ordenar por dono" Visibility="{Binding OwnerVisibility, Source={StaticResource Columns}}">
                                <TextBlock TextTrimming="CharacterEllipsis"><Run Text="Dono" /><Run Text="{Binding SortOwner, Mode=OneWay}" FontSize="9" /></TextBlock>
                            </Button>
                            <Thumb Grid.Column="3" Style="{StaticResource ColumnGrip}" Tag="Owner" DragStarted="OnGripStarted" DragDelta="OnGripDelta" DragCompleted="OnGripCompleted"
                                   MouseDoubleClick="OnGripDoubleClick" Visibility="{Binding OwnerVisibility, Source={StaticResource Columns}}" />

                            <Button Grid.Column="4" Style="{StaticResource HeaderCell}" Tag="Group" Click="OnSortHeader" HorizontalContentAlignment="Left"
                                    AutomationProperties.Name="Ordenar por grupo" Visibility="{Binding GroupVisibility, Source={StaticResource Columns}}">
                                <TextBlock TextTrimming="CharacterEllipsis"><Run Text="Grupo" /><Run Text="{Binding SortGroup, Mode=OneWay}" FontSize="9" /></TextBlock>
                            </Button>
                            <Thumb Grid.Column="4" Style="{StaticResource ColumnGrip}" Tag="Group" DragStarted="OnGripStarted" DragDelta="OnGripDelta" DragCompleted="OnGripCompleted"
                                   MouseDoubleClick="OnGripDoubleClick" Visibility="{Binding GroupVisibility, Source={StaticResource Columns}}" />

                            <Button Grid.Column="5" Style="{StaticResource HeaderCell}" Tag="Permissions" Click="OnSortHeader" HorizontalContentAlignment="Left"
                                    AutomationProperties.Name="Ordenar por permissões" Visibility="{Binding PermissionsVisibility, Source={StaticResource Columns}}">
                                <TextBlock TextTrimming="CharacterEllipsis"><Run Text="Permissões" /><Run Text="{Binding SortPermissions, Mode=OneWay}" FontSize="9" /></TextBlock>
                            </Button>
                            <Thumb Grid.Column="5" Style="{StaticResource ColumnGrip}" Tag="Permissions" DragStarted="OnGripStarted" DragDelta="OnGripDelta" DragCompleted="OnGripCompleted"
                                   MouseDoubleClick="OnGripDoubleClick" Visibility="{Binding PermissionsVisibility, Source={StaticResource Columns}}" />
                        </Grid>
                    </ScrollViewer>
                </Border>
                <ListBox Grid.Row="1" x:Name="List" FocusVisualStyle="{x:Null}"
                         ItemsSource="{Binding Entries}"
                         SelectionMode="Extended"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="4,0"
                         AllowDrop="True"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         KeyDown="OnListKeyDown"
                         PreviewMouseWheel="OnListWheel"
                         PreviewMouseRightButtonDown="OnListRightClick"
                         PreviewMouseLeftButtonDown="OnListMouseDown"
                         PreviewMouseMove="OnListMouseMove"
                         PreviewMouseLeftButtonUp="OnListMouseUp"
                         DragOver="OnDragOver"
                         Drop="OnDrop">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource RdListItem}">
                            <Setter Property="Padding" Value="6,0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="Height" Value="26" />
                            <!-- Dois cliques no próprio item: pasta entra, arquivo abre no editor -->
                            <EventSetter Event="MouseDoubleClick" Handler="OnItemDoubleClick" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type remote:RemoteEntryViewModel}">
                            <Grid ToolTip="{Binding ToolTip}" Opacity="{Binding Opacity}" Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding NameWidth, Source={StaticResource Columns}}" />
                                    <ColumnDefinition Width="{Binding SizeWidth, Source={StaticResource Columns}}" />
                                    <ColumnDefinition Width="{Binding ModifiedWidth, Source={StaticResource Columns}}" />
                                    <ColumnDefinition Width="{Binding OwnerWidth, Source={StaticResource Columns}}" />
                                    <ColumnDefinition Width="{Binding GroupWidth, Source={StaticResource Columns}}" />
                                    <ColumnDefinition Width="{Binding PermissionsWidth, Source={StaticResource Columns}}" />
                                </Grid.ColumnDefinitions>
                                <DockPanel ClipToBounds="True">
                                    <!-- Ícone do tipo (como no VS Code); o símbolo simples só aparece se os ícones não carregarem -->
                                    <Grid DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Image Source="{Binding IconImage}" Width="16" Height="16" />
                                        <ui:SymbolIcon Symbol="{Binding Icon}" Filled="{Binding IsDirectory}" Foreground="{Binding IconBrush}" FontSize="16"
                                                       Visibility="{Binding GlyphVisibility}" />
                                        <Border Visibility="{Binding LinkVisibility}" Width="9" Height="9" CornerRadius="2" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                Margin="0,0,-3,-2" Background="{DynamicResource RdSurface}" ToolTip="Link simbólico">
                                            <ui:SymbolIcon Symbol="Link12" FontSize="8" Foreground="{DynamicResource RdAccent}" />
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="13" Margin="0,0,8,0" />
                                </DockPanel>
                                <TextBlock Grid.Column="1" Style="{StaticResource Cell}" Text="{Binding SizeText}" TextAlignment="Right" Margin="6,0,10,0"
                                           Visibility="{Binding SizeVisibility, Source={StaticResource Columns}}" />
                                <TextBlock Grid.Column="2" Style="{StaticResource Cell}" Text="{Binding ModifiedText}"
                                           Visibility="{Binding ModifiedVisibility, Source={StaticResource Columns}}" />
                                <TextBlock Grid.Column="3" Style="{StaticResource Cell}" Text="{Binding Owner}"
                                           Visibility="{Binding OwnerVisibility, Source={StaticResource Columns}}" />
                                <TextBlock Grid.Column="4" Style="{StaticResource Cell}" Text="{Binding Group}"
                                           Visibility="{Binding GroupVisibility, Source={StaticResource Columns}}" />
                                <TextBlock Grid.Column="5" Style="{StaticResource Cell}" Text="{Binding Permissions}" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                           Visibility="{Binding PermissionsVisibility, Source={StaticResource Columns}}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ui:ProgressRing Grid.Row="1" IsIndeterminate="True" Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,10,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}" />

                <!-- Conectando / erro / desconectado -->
                <Border Grid.RowSpan="2" Background="{DynamicResource RdSurface}" Visibility="{Binding State, Converter={StaticResource StateIs}, ConverterParameter=Connecting|Error|Idle}">
                    <StackPanel VerticalAlignment="Center" Margin="20">
                        <ui:ProgressRing IsIndeterminate="True" Width="28" Height="28" HorizontalAlignment="Center"
                                         Visibility="{Binding State, Converter={StaticResource StateIs}, ConverterParameter=Connecting}" />
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0" Foreground="{DynamicResource RdTextDim}" />
                        <ui:Button Content="Tentar de novo" HorizontalAlignment="Center" Margin="0,12,0,0" Click="OnRetry"
                                   Visibility="{Binding State, Converter={StaticResource StateIs}, ConverterParameter=Error}" />
                    </StackPanel>
                </Border>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
