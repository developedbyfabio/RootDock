<Application x:Class="RootDock.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!--
                Paleta do RootDock (tema "Escuro"). Os temas trocam estes pincéis em tempo real
                (Services/AppThemes.cs): use sempre {DynamicResource Rd...} no XAML.
            -->
            <SolidColorBrush x:Key="RdBackground" Color="#11141A" />
            <SolidColorBrush x:Key="RdSurface" Color="#171B23" />
            <SolidColorBrush x:Key="RdPanel" Color="#13161D" />
            <SolidColorBrush x:Key="RdInset" Color="#0F1217" />
            <SolidColorBrush x:Key="RdHover" Color="#1C212B" />
            <SolidColorBrush x:Key="RdHoverStrong" Color="#232A38" />
            <SolidColorBrush x:Key="RdChip" Color="#262C38" />
            <SolidColorBrush x:Key="RdBorder" Color="#262C38" />
            <SolidColorBrush x:Key="RdGuide" Color="#323A4B" />
            <SolidColorBrush x:Key="RdGuideActive" Color="#4A5670" />
            <SolidColorBrush x:Key="RdFocusBorder" Color="#33466B" />
            <SolidColorBrush x:Key="RdTrack" Color="#1F2430" />
            <SolidColorBrush x:Key="RdText" Color="#D7DAE0" />
            <SolidColorBrush x:Key="RdTextDim" Color="#8B93A5" />
            <SolidColorBrush x:Key="RdAccent" Color="#7AA2F7" />
            <SolidColorBrush x:Key="RdAccentSoft" Color="#22304A" />
            <SolidColorBrush x:Key="RdOnAccent" Color="#11141A" />
            <SolidColorBrush x:Key="RdSelection" Color="#2A3A5C" />
            <SolidColorBrush x:Key="RdSelectionInactive" Color="#232A38" />
            <SolidColorBrush x:Key="RdWarnBg" Color="#3A2E1A" />
            <SolidColorBrush x:Key="RdProd" Color="#F7768E" />
            <SolidColorBrush x:Key="RdProdSoft" Color="#2A1A20" />
            <SolidColorBrush x:Key="RdStaging" Color="#E0AF68" />
            <SolidColorBrush x:Key="RdDev" Color="#9ECE6A" />
            <SolidColorBrush x:Key="RdDevSoft" Color="#1E3A2A" />

            <!--
                Item de lista legível em qualquer tema (arquivos, gerenciador): seleção suave com a
                barra de destaque à esquerda, como no VS Code; o texto mantém a cor normal.
            -->
            <Style x:Key="RdListItem" TargetType="ListBoxItem">
                <Setter Property="Foreground" Value="{DynamicResource RdText}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Padding" Value="6,0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Grid Background="Transparent">
                                <Border x:Name="Bg" Margin="2,1" CornerRadius="4" Background="{TemplateBinding Background}" />
                                <Border x:Name="Bar" Width="2" Margin="2,4" HorizontalAlignment="Left" CornerRadius="1"
                                        Background="{DynamicResource RdAccent}" Visibility="Collapsed" />
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource RdHover}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource RdSelection}" />
                                    <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsSelected" Value="True" />
                                        <Condition Property="Selector.IsSelectionActive" Value="False" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource RdSelectionInactive}" />
                                    <Setter TargetName="Bar" Property="Opacity" Value="0.55" />
                                </MultiTrigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
