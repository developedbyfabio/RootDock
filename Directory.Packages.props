<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
    <!-- Já vem com o SSH.NET; referenciado direto para gerar chaves Ed25519 (SshKeys). -->
    <PackageVersion Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <!-- Console serial (COM): switches, roteadores, equipamentos -->
    <PackageVersion Include="System.IO.Ports" Version="10.0.0" />
    <!-- FTP e FTPS (gerenciador de arquivos) -->
    <PackageVersion Include="FluentFTP" Version="55.1.0" />
    <PackageVersion Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="WPF-UI" Version="4.3.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <!-- Instalador e atualização automática pelas Releases do GitHub -->
    <PackageVersion Include="Velopack" Version="1.2.161" />
  </ItemGroup>
</Project>
